# Qwen3.6-35B-A3B 运行配置
# 用法：cp .env.example .env  然后按需修改。
# 这些值会被 docker-compose.yml 读取；改完必须 `pixi run recreate` 才会生效。

# ============ 模型 ============
# GGUF 仓库与文件名（scripts/download_model.sh 用同一组变量）
MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
# 对外暴露的模型名（OpenAI API 的 model 字段）
MODEL_ALIAS=qwen3.6-35b-a3b
# 可选：视觉投影文件（多模态）。设置后需同时取消 docker-compose.yml 里 --mmproj 两行的注释
# MMPROJ_FILE=mmproj-F16.gguf

# ============ 镜像 ============
# 默认固定到已验证的 build（qwen3_5_moe / 混合 GDN 架构需要较新的 build）。
# 锁定 digest：`pixi run pin-image`；自编译镜像：`pixi run build-image`
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b11146

# ============ 服务 ============
# 监听地址：默认只绑本机回环。局域网 / 远程访问改成 0.0.0.0（服务无鉴权，注意风险）
BIND_ADDR=127.0.0.1
PORT=8080

# ============ 上下文与显存 ============
# 最大上下文：128K。该模型原生 256K（max_position_embeddings=262144），128K 在原生范围内
CTX_SIZE=131072
# 全部层都放显存，MoE 专家由 N_CPU_MOE 控制
N_GPU_LAYERS=99
# 前 N 层的 MoE 专家权重留在系统内存（40 层模型）。
# 专家张量占权重的 88%（19.67 GB，每层约 0.492 GB），所以这是 12G 卡唯一真正省显存的旋钮。
# 28 是按 12G 卡的显存账算出的、留有余量的起点：显存里放 2.68 GB 非专家 + 12×0.492 GB 专家。
# 扫参：pixi run tune-ncmoe（从 40 往下试，取最后一个能起来的值再回退一档）
N_CPU_MOE=28
# 关掉自动调参，避免「空上下文估得下、填满后 OOM」
FIT=off

# ============ 长上下文 ============
# K/V 必须同类型（都用 q8_0 或都用 q4_0），否则 CUDA FlashAttention 静默回落 CPU
FLASH_ATTN=on
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
# none = 不走 mmap（旧版 --no-mmap）。代价：权重整份进内存，约等于模型文件大小
LOAD_MODE=none

# ============ 批 / 线程 / 并发 ============
BATCH_SIZE=2048
UBATCH_SIZE=1024
# -1 = 自动
THREADS=-1
# 1 个 slot 独占 128K KV
PARALLEL=1