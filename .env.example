# Qwen3.6-35B-A3B 运行配置
# 用法：cp .env.example .env  然后按需修改。
# 这些值会被 docker-compose.yml 读取；改完必须 `pixi run recreate` 才会生效。

# ============ 模型 ============
# GGUF 仓库与文件名（scripts/download_model.sh 用同一组变量）
MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
# 对外暴露的模型名（OpenAI API 的 model 字段）
MODEL_ALIAS=qwen3.6-35b-a3b
# 可选：视觉投影文件（多模态）。设置后需同时取消 docker-compose.yml 里 --mmproj 两行的注释
# MMPROJ_FILE=mmproj-F16.gguf

# ============ 镜像 ============
# 默认固定到已验证的 build（qwen3_5_moe / 混合 GDN 架构需要较新的 build）。
# 锁定 digest：`pixi run pin-image`；自编译镜像：`pixi run build-image`
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b11146

# ============ 服务 ============
# 监听地址：默认只绑本机回环。局域网 / 远程访问改成 0.0.0.0（服务无鉴权，注意风险）
BIND_ADDR=127.0.0.1
PORT=8080

# ============ 上下文与显存 ============
# 最大上下文：128K。该模型原生 256K（max_position_embeddings=262144），128K 在原生范围内
CTX_SIZE=131072
# 全部层都放显存，MoE 专家由 N_CPU_MOE 控制
N_GPU_LAYERS=99
# 前 N 层的 MoE 专家权重留在系统内存（40 层模型）。
# 专家张量占权重的 88%（19.67 GB，每层约 0.492 GB），所以这是 12G 卡唯一真正省显存的旋钮。
# 28 是按 12G 卡的显存账算出的、留有余量的起点：显存里放 2.68 GB 非专家 + 12×0.492 GB 专家。
# 扫参：pixi run tune-ncmoe（从 40 往下试，取最后一个能起来的值再回退一档）
N_CPU_MOE=28
# 关掉自动调参，避免「空上下文估得下、填满后 OOM」
FIT=off

# ============ 长上下文 ============
# K/V 必须同类型（都用 q8_0 或都用 q4_0），否则 CUDA FlashAttention 静默回落 CPU
FLASH_ATTN=on
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
# none = 不走 mmap（旧版 --no-mmap）。代价：权重整份进内存，约等于模型文件大小
LOAD_MODE=none

# ============ 批 / 线程 / 并发 ============
BATCH_SIZE=2048
UBATCH_SIZE=1024
# -1 = 自动
THREADS=-1
# 1 个 slot 独占 128K KV
PARALLEL=1
# ============ 模型二：Qwen3.8-Flash-Next（Strata 引擎，`pixi run strata-up`）============
# 这段和上面的模型一互不影响：strata 服务只在 `--profile strata` 下启动。

# 镜像：cuda13 需要驱动 580+（RTX 20/30/40/50）；cuda12 用于 GTX 10 / P100 / V100 或驱动 575–579
# 版本 tag 换成 latest-cuda13 会跟随最新版；也可以固定到别的已验证版本（如 0.2.7-cuda13）
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.11-cuda13

# 对外端口：和模型一的 8080 错开，默认 8081，只绑回环
STRATA_BIND_ADDR=127.0.0.1
STRATA_PORT=8081

# 模型档位：qwen（原版 Flash-Next）分 Q2_0 / IQ2_XS / IQ3_XXS / IQ3_S 四档
#   Q2_0    37.6 GB 权重，最快，48G 内存可跑
#   IQ2_XS  39.2 GB 权重，速度快、质量更好（默认，推荐 64G 内存）
#   IQ3_XXS 47.0 GB 权重，更慢，质量更好（推荐 64G 内存）
#   IQ3_S   54.8 GB 权重，最慢，质量最好（需 60G 内存；3060 12G 实测 decode 19-20 tok/s，下载 84 GB）
# 32G 内存的机器改用 coder 档（half experts，面向代码）：STRATA_FAMILY=coder / STRATA_MODEL=IQ1_M
STRATA_FAMILY=qwen
STRATA_MODEL=IQ2_XS

# 上下文：32k / 64k / 128k / 256k，或直接写 token 数。128k 在 3060 + 64G 内存上有实测
STRATA_CONTEXT=128k
# 会话 KV 格式：int8（默认）/ q4_0（省一半）/ k8v4 / fp16
STRATA_KV=int8

# 多模态图片：off / on（要额外下载约 0.9 GB 的图片读取器，12G 卡上跑在 CPU）
STRATA_VISION=off

# 首启是否做硬件校准：skip（默认）/ quick（约 5–20 分钟，只做一次，结果存进 ./strata-data）
STRATA_TUNE=skip

# 并发请求数：留空 = 按显卡自动；范围 1–8
STRATA_PARALLEL=

# 访问用的 API key：16 字符以上（openssl rand -hex 24）。
# 留空则首启自动生成并存在 ./strata-data 里，用 `pixi run strata-key` 查看
STRATA_API_KEY=

# 给系统留出的空闲内存（GiB）：0 = 尽量用满（默认）。
# 机器还要跑别的程序、或跑 IQ3_S 这种大档位时，设 6–8 可避免整机被内存回收拖死
STRATA_RAM_KEEP_GIB=0
# 高级引擎参数，空格分隔 KEY=VALUE，等价于 `strata launch --set`，一般留空。
# 例：STRATA_SET="STRATA_ROUTE_PRIOR=1.5"（12G 卡上加速，但长 agent 会话可能重复）
STRATA_SET=

# 模型下载源：留空 = HuggingFace（默认）；modelscope = 魔搭（国内同名仓库、同路径，Strata 原生支持）
# 首次启动下载 GGUF 分片 + MTP 草稿层都走这个源，切换后要 `pixi run strata-recreate`
# 已经下载过的文件在 ./strata-data 里，不会重复下
STRATA_SOURCE=
# HuggingFace 镜像站（可选，例如 https://hf-mirror.com）；和 STRATA_SOURCE 二选一即可
HF_ENDPOINT=
