# 本地 LLM 服务配置
# 用法：cp .env.example .env  然后按需修改。
# 这些值会被 docker-compose.yml 读取；改完要 `pixi run recreate` 才会生效。

# ============ 选模型 ============
# 同一个 Strata 服务，三选一。切换用 `pixi run model-flash|model-35b|model-inkling`
# （会改写下面三行并重建容器），也可以手改后 `pixi run recreate`。
#
#   Flash-Next（默认）  qwen            IQ2_XS       下载约 68 GB，内存建议 64 GiB
#   35B-A3B            qwen36          UD-Q4_K_XL   下载约 23 GB，内存 32 GiB 起
#   Inkling 2 Mini     inkling-2-mini  SQ-10        下载约 10.5 GB，12G 卡 32K 可用（冷专家自动落内存/SSD），内存 16 GiB 起
STRATA_FAMILY=qwen
STRATA_MODEL=IQ2_XS
# Strata 在数据目录里保存运行参数的槽位名；每个模型各用一个，互不覆盖
STRATA_PRESET=flash-next

# ============ 镜像 ============
# cuda13 需要驱动 580+（RTX 20/30/40/50）；cuda12 用于 GTX 10 / P100 / V100 或驱动 575–579
# 版本 tag 换成 latest-cuda13 会跟随最新版；也可以固定到别的已验证版本（如 0.2.21-cuda13）
# 0.2.21 起镜像自带 Inkling 引擎 0.1.67（四级 MoE + 32K+ KV offload）；更老的 0.2.19 只有 0.1.65，
# 12 GiB 卡跑 SQ-10 32K 会因专家全量进显存而 CUDA OOM。
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.21-cuda13

# ============ 服务 ============
# 默认只绑本机回环。局域网 / 远程访问改成 0.0.0.0（服务强制要求 API key，但仍建议加反代）
STRATA_BIND_ADDR=127.0.0.1
STRATA_PORT=8080

# 空闲释放：30 分钟没有新请求就卸载模型，释放显存和内存；下一次请求自动加载。
# 由 idle-unload 辅助容器执行（POST /unload），0 = 关闭；改完 `pixi run recreate`。
STRATA_IDLE_UNLOAD_S=1800
# 辅助容器的检查间隔（秒）；30 分钟的阈值误差不会超过这个值
STRATA_IDLE_POLL_S=60
# 两次卸载的最小间隔（秒）：默认 600，和 Strata 的熔断窗口一致（引擎 10 分钟内死 3 次就返回 503）。
# 一次空闲只会卸载一次，这里是兜底：卸载后刚重载又立刻再卸，会把重载失败叠成熔断。0 = 不限制
STRATA_IDLE_UNLOAD_COOLDOWN_S=600

# 数据目录（宿主机路径，挂到容器的 /data）：所有模型的权重、预处理包、草稿层、preset、API key 都在这里
# 默认 ./strata-data；已经用别的目录下好模型时指过去（如 /mnt/raid/llm_models），不会再重复下载
STRATA_DATA_DIR=./strata-data

# 已经有一份 GGUF 分片目录时：挂进容器（默认 ./models → /models），再在下面指定容器内路径
# STRATA_MODEL_HOST_DIR 是宿主机上的分片目录；STRATA_MODEL_PATH 留空表示让 Strata 自己下载
STRATA_MODEL_HOST_DIR=./models
STRATA_MODEL_PATH=

# ============ 上下文与显存 ============
# 32k / 64k / 128k / 256k，或直接写 token 数
# 128k 是 Flash-Next 的实测值；35B-A3B 在 12G 卡上建议 32k（Strata 按卡自动选时会这样给）
# Inkling 2 Mini 常用 32k（可到 256k，最长 1M）
# 注意 Inkling 从 32K 起把 KV 放到 host（内存）：32K 约 1.1 GiB，128K 约 4.3 GiB。
# 16 GiB 内存的机器只能用 32k；128K 在闲置卸载后重新加载会因内存不足被结束，3 次后 Strata 熔断（503）。
# `pixi run preflight` 会按机器内存核对，`pixi run model-inkling` 会自动降到装得下的档位。
STRATA_CONTEXT=128k
# 会话 KV 格式：int8（默认）/ q4_0（省一半）/ k8v4 / fp16
STRATA_KV=int8
# 图片输入：off / on / gpu / cpu（on 要额外下载约 0.9 GB 的图片读取器，12G 卡上跑在 CPU）
# Inkling 2 Mini 的 Vision 分片 0.64 GB；本项目默认关，要看图改 on
STRATA_VISION=off

# 首启是否做硬件校准：skip（默认）/ quick（约 5–20 分钟，只做一次，结果存进数据目录）
STRATA_TUNE=skip
# 并发请求数：留空 = 按显卡自动；范围 1–8
STRATA_PARALLEL=
# 给系统留出的空闲内存（GiB）：0 = 尽量用满（默认）。
# 机器还要跑别的程序时设 6–8，避免整机被内存回收拖死
STRATA_RAM_KEEP_GIB=0
# 高级引擎参数，空格分隔 KEY=VALUE，等价于 `strata launch --set`，一般留空。
# 例：STRATA_SET="STRATA_ROUTE_PRIOR=1.5"（12G 卡上加速，但长 agent 会话可能重复）
STRATA_SET=

# ============ API key ============
# 16 字符以上（openssl rand -hex 24）。
# 留空则首启自动生成并存在数据目录里，用 `pixi run key` 查看
STRATA_API_KEY=

# ============ 下载源 ============
# 留空 = HuggingFace（默认）；modelscope = 魔搭（国内同名仓库、同路径，Strata 原生支持）
# 只作用于 Qwen 家族（Flash-Next / 35B-A3B）；Inkling 见下面的 STRATA_INKLING_SOURCE
# 首次启动下载模型文件都走这个源，切换后要 `pixi run recreate`
# 已经下载过的文件在数据目录里，不会重复下
STRATA_SOURCE=
# HuggingFace 镜像站（可选，例如 https://hf-mirror.com）；和 STRATA_SOURCE 二选一即可
HF_ENDPOINT=

# Inkling 2 Mini 的下载源：不走上面两项，要单独指完整 base。
# 留空 = https://huggingface.co/strata-engine/Inkling-2-Mini-Strata/resolve/main
# 国内推荐魔搭（注意分支是 resolve/master）：
#   STRATA_INKLING_SOURCE=https://www.modelscope.cn/models/strata-engine/Inkling-2-Mini-Strata/resolve/master
# 或 HuggingFace 镜像站：
#   STRATA_INKLING_SOURCE=https://hf-mirror.com/strata-engine/Inkling-2-Mini-Strata/resolve/main
STRATA_INKLING_SOURCE=

# ============ Inkling 2 Mini 档位 ============
# 切到 Inkling 时 STRATA_MODEL 可选（推荐 12G 卡用 SQ-10）：
#   SQ-10  10.47 GB  12 GiB 卡 32K 可用（引擎留热专家，其余落内存/SSD）；内存 16 GiB 起（默认）
#   SQ-15  14.35 GB  16 GiB 卡整份放进显存；12 GiB 卡 + 24 GiB 内存走 hybrid
#   SQ-20  19.35 GB  24 GiB 卡 / 32 GiB 统一内存；与原模型逐位一致
# 默认上下文 32k（可选 8k/32k/64k/128k/256k，最长 1M）；并发可到 64

# ============ Qwen3.6-35B-A3B 档位 ============
# 切到 35B-A3B 时 STRATA_MODEL 可选：
#   UD-Q4_K_XL  22.9 GB 权重，内存 32 GiB 起（12G 卡推荐，默认）
#   UD-Q6_K_XL  32.6 GB 权重，内存 44 GiB 起
#   Q8_0        37.8 GB 权重，内存 52 GiB 起
# Flash-Next（STRATA_FAMILY=qwen）的档位：Q2_0 / IQ2_XS / IQ3_XXS / IQ3_S，默认 IQ2_XS
